{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": ["AGENTS.md"],
  "permission": {
    "webfetch": "allow",
    "edit": "allow",
    "skill": { "*": "allow" },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "* publish*": "deny"
    }
  }
}
