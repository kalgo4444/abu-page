{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "webfetch": "allow",
    "edit": "allow",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "* publish*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-f1118855-583f-4682-b656-a85505c00445"
      }
    }
  }
}