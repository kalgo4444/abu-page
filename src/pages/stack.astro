---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';

const databases = profile.stack.find(group => group.label === 'Databases')?.items ?? [];

// Fig 1, drawn for wide and narrow screens. Plain ASCII so every cell lines up.
// The database box is sized to whatever profile.stack lists.
const dbLabel = databases.join(' · ');
const dbRule = `+${'-'.repeat(dbLabel.length + 2)}+`;

const figureWide = [
	'+------------------+',
	'| React · Next.js  |---+',
	`+------------------+   |     +-------------------+      ${dbRule}`,
	`                       +---->| NestJS · REST API |----->| ${dbLabel} |`,
	`+------------------+   |     +-------------------+      ${dbRule}`,
	'| React Native     |---+',
	'+------------------+',
].join('\n');

// Narrow: centre the database box under the arrow in column 12.
const dbIndent = ' '.repeat(Math.max(0, 12 - Math.floor(dbRule.length / 2)));

const figureNarrow = [
	'+---------+  +--------------+',
	'| React   |  | React Native |',
	'| Next.js |  |              |',
	'+----+----+  +------+-------+',
	'     |              |',
	'     +------+-------+',
	'            |',
	'            v',
	'  +-------------------+',
	'  | NestJS · REST API |',
	'  +---------+---------+',
	'            |',
	'            v',
	`${dbIndent}${dbRule}`,
	`${dbIndent}| ${dbLabel} |`,
	`${dbIndent}${dbRule}`,
].join('\n');
---

<Layout title={`Stack · ${profile.name}`} description={profile.summary}>
	<section class="page container">
		<h1>Stack</h1>
		<figure class="figure">
			<div
				role="img"
				aria-label={`Diagram: React, Next.js and React Native clients call a NestJS REST API, which reads and writes ${databases.join(' and ')}.`}
			>
				<pre class="figure-wide" aria-hidden="true">{figureWide}</pre>
				<pre class="figure-narrow" aria-hidden="true">{figureNarrow}</pre>
			</div>
			<figcaption>Fig 1. The stack, from client to database.</figcaption>
		</figure>
		<dl>
			{
				profile.stack.map(group => (
					<div class="row row-pair">
						<dt>{group.label}</dt>
						<dd>{group.items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</section>
</Layout>

<style>
	/* chart-tile */
	.figure {
		margin-bottom: var(--space-lg);
		padding-block: var(--space-lg);
	}

	.figure pre {
		color: var(--body);
		line-height: 1.25;
		overflow-x: auto;
		/* Ligatures would redraw `|---` and `--->` and break the grid. */
		font-variant-ligatures: none;
	}

	.figure-narrow {
		display: none;
		font-size: 14px;
	}

	.figure figcaption {
		margin-top: var(--space-lg);
		color: var(--mute);
		font-size: 14px;
		line-height: 2;
	}

	@media (max-width: 850px) {
		.figure-wide {
			display: none;
		}

		.figure-narrow {
			display: block;
		}
	}
</style>
