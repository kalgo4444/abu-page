{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"permission": {
		"webfetch": "allow",
		"edit": "allow",
		"skill": {
			"*": "allow"
		},
		"bash": {
			"*": "allow",
			"rm *": "deny",
			"sudo *": "deny"
		}
	},
	"instructions": ["AGENTS.md", ".opencode/USER.md", ".opencode/rules/*.md"]
}
