{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"headers": {
				"CONTEXT7_API_KEY": "ctx7sk-b07433f4-8683-4355-b265-91d4b7c8c8bd"
			}
		}
	},
	"permission": {
		"webfetch": "allow",
		"edit": "allow",
		"skill": {
			"*": "allow"
		},
		"bash": {
			"*": "allow",
			"rm *": "deny",
			"sudo *": "deny"
		}
	},
	"instructions": ["AGENTS.md", ".opencode/USER.md", ".opencode/rules/*.md"]
}
